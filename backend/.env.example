# Configurações gerais da aplicação
PROJECT_NAME="Vigia Escolar API"
API_V1_STR="/api/v1"
ENVIRONMENT="development"

# CORS (origens separadas por vírgula)
BACKEND_CORS_ORIGINS="http://localhost:3000,https://plreis.github.io"

# Segurança e JWT (configuração para Sprint 3)
SECRET_KEY="exemplo-chave-secreta-alterar-em-producao"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Banco de dados Supabase / PostgreSQL (configuração para Sprint 4)
# DATABASE_URL="postgresql://postgres:[SENHA]@[HOST]:5432/postgres"

# Inteligência Artificial Gemini (configuração para Sprint 2)
# GEMINI_API_KEY="sua-chave-api-aqui"
GEMINI_MODEL="gemini-1.5-flash"
