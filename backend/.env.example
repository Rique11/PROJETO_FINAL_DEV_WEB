# Copie para .env (desenvolvimento) ou cadastre no Coolify (produção).
# Todas têm valor padrão em app/core/config.py; em produção, as marcadas
# com [obrigatória] precisam ser definidas.

# --- Aplicação ---
PROJECT_NAME="Proteca API"
# [obrigatória] "production" no Coolify. Em produção a API não sobe com SECRET_KEY fraca.
ENVIRONMENT="development"

# [obrigatória] Origens do frontend, separadas por vírgula, sem barra e sem caminho no final.
# Ex.: "https://app.<ip-com-hifens>.sslip.io,http://localhost:3000"
BACKEND_CORS_ORIGINS="http://localhost:3000"

# --- JWT (Sprint 3) ---
# [obrigatória] 32+ caracteres. Gere com: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY="troque-esta-chave"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
# [obrigatória] Hash Argon2 da senha de professor@proteca.local (até a Sprint 4).
# Gere com: .venv/bin/python -c "from pwdlib import PasswordHash; print(PasswordHash.recommended().hash('SUA_SENHA'))"
# No Coolify, marque como "Is Literal" (o hash tem $). Inválido = login 401.
SENHA_TESTE_HASH=""

# --- Banco Supabase (Sprint 4) ---
# Vazio = repositório em memória. Use a string do "Session pooler" (IPv4), porta 5432.
# DATABASE_URL="postgresql+psycopg://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:5432/postgres?sslmode=require"
DATABASE_URL=""
# Carrega os dados de demonstração (escola, turmas, aparelhos, sessões) ao iniciar.
SEED_DEMO_DATA=true

# --- Gemini (só no backend, nunca no frontend) ---
# Vazio = o Live usa o fallback local (is_mock=true).
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-latest"
GEMINI_TIMEOUT_SECONDS=20
