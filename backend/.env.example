# Copie para .env (desenvolvimento) ou cadastre no Coolify (produção).
PROJECT_NAME="Proteca API"
ENVIRONMENT="development"

# Origens do frontend, separadas por vírgula, sem barra no final.
BACKEND_CORS_ORIGINS="http://localhost:3000"

# JWT (Sprint 3). Em produção gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY="troque-esta-chave"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Banco Supabase (Sprint 4). Use a string do "Session pooler" (IPv4), porta 5432.
# DATABASE_URL="postgresql+psycopg://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:5432/postgres?sslmode=require"
SEED_DEMO_DATA=true

# Gemini: só no backend. Sem chave, o Live usa o fallback local (is_mock=true).
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-latest"
